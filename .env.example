ENVIRONMENT=development
DEMO_ENABLED=true
POSTGRES_PASSWORD=local-development-change-me
DATABASE_URL=postgresql+psycopg://approval:local-development-change-me@db/approval
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/private
STORAGE_BACKEND=filesystem
ALLOWED_ORIGIN=http://localhost:3000
AI_ENABLED=false
MAX_FILE_MB=15
MAX_PAGES=30
MAX_IMAGE_PIXELS=25000000
SESSION_HOURS=8
RETENTION_DAYS=365
