ENVIRONMENT=production
DEMO_ENABLED=false
AI_ENABLED=false
PROCESSING_MODE=embedded
DATABASE_URL=REPLACE_WITH_SUPABASE_SESSION_POOLER_URI
REDIS_URL=REPLACE_WITH_RENDER_INTERNAL_KEY_VALUE_URL
ALLOWED_ORIGIN=https://REPLACE.vercel.app
STORAGE_BACKEND=s3
STORAGE_DIR=/tmp/approvallens-private
S3_BUCKET=approvallens-private
S3_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
AWS_ACCESS_KEY_ID=REPLACE_WITH_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_S3_SECRET
AWS_DEFAULT_REGION=REPLACE_WITH_SUPABASE_REGION
MAX_FILE_MB=4
MAX_PAGES=5
MAX_DOCUMENT_VERSIONS=12
MAX_IMAGE_PIXELS=12000000
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_YOUR_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
