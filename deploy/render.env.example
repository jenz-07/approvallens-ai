ENVIRONMENT=production
DEMO_ENABLED=false
AI_ENABLED=false
DATABASE_URL=postgresql+psycopg://REPLACE_SESSION_POOLER_CONNECTION?sslmode=require
REDIS_URL=redis://REPLACE_INTERNAL_REDIS_URL
ALLOWED_ORIGIN=https://REPLACE.vercel.app
STORAGE_BACKEND=s3
STORAGE_DIR=/tmp/approvallens-private
S3_BUCKET=approvallens-private
S3_ENDPOINT=https://REPLACE.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=REPLACE_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_S3_SECRET
AWS_DEFAULT_REGION=REPLACE_REGION
MAX_FILE_MB=4
MAX_PAGES=30
